rules_version = '2';

// KIL basar – sikkerhetsregler. Se spesifikasjonen «Datamodell og sikkerhet».
// Utgangspunkt: ingen leser personopplysninger uten admin-innlogging.
// Endringer her limes inn i Firebase-konsollen ETTER at `npm run test:rules` består.
service cloud.firestore {
  match /databases/{database}/documents {

    // Admin-kontoer. Reservekonto legges til her.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['pji.idistudios@gmail.com'];
    }

    // Frist for oppmøteregistrering: 6.1.2027 (én uke etter basaren). Endres her hvert år.
    function beforeDeadline() {
      return request.time < timestamp.date(2027, 1, 7);
    }

    // Hemmelig lenke: anonym innlogging + sessions/{uid} som peker på access/{token}
    function link() {
      return get(/databases/$(database)/documents/access/$(get(/databases/$(database)/documents/sessions/$(request.auth.uid)).data.token)).data;
    }
    function hasSession() {
      return request.auth != null && exists(/databases/$(database)/documents/sessions/$(request.auth.uid));
    }
    function stationLinkFor(key) {
      return hasSession() && link().kind == 'stasjon' && link().stationKey == key;
    }

    function counterPath(shiftId) {
      return /databases/$(database)/documents/shiftCounts/$(shiftId);
    }
    function signupPath(id) {
      return /databases/$(database)/documents/signups/$(id);
    }

    // Oppsett: alle kan lese, bare admin kan skrive
    match /config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Telling per skift. Offentlig kan bare øke med 1, aldri over max,
    // og bare sammen med en NY påmelding på samme skift i samme skriving.
    match /shiftCounts/{shiftId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['count', 'lastSignup'])
        && request.resource.data.count == resource.data.count + 1
        && request.resource.data.count <= resource.data.max
        && request.resource.data.lastSignup is string
        && !exists(signupPath(request.resource.data.lastSignup))
        && getAfter(signupPath(request.resource.data.lastSignup)).data.shiftId == shiftId
      );
    }

    // Påmeldinger: offentlig kan bare opprette (validert). Lesing kun admin.
    match /signups/{signupId} {
      function validBase(d) {
        return d.keys().hasOnly(['name', 'phone', 'email', 'day', 'timePref', 'source', 'attended', 'createdAt', 'shiftId', 'stationKey', 'status'])
          && d.keys().hasAll(['name', 'phone', 'email', 'day', 'timePref', 'source', 'attended', 'createdAt', 'shiftId', 'stationKey', 'status'])
          && d.name is string && d.name.size() >= 2 && d.name.size() <= 80
          && d.phone is string && d.phone.matches('^[+][1-9][0-9]{7,14}$')
          && d.email == ''
          && d.stationKey is string
          && d.day in ['opprigg', 'd1', 'd2']
          && d.timePref in ['hele', 'for18', 'etter18']
          && d.source == 'app'
          && d.attended == false
          && d.createdAt == request.time;
      }

      allow read, update, delete: if isAdmin();

      // Stasjonslenke: les egen stasjon, endre bare «attended», før fristen
      allow read: if stationLinkFor(resource.data.stationKey);
      allow update: if stationLinkFor(resource.data.stationKey)
        && resource.data.status == 'aktiv'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['attended'])
        && request.resource.data.attended is bool
        && beforeDeadline();

      allow create: if isAdmin() || (
        validBase(request.resource.data) && (
          (request.resource.data.status == 'aktiv'
            && request.resource.data.shiftId is string
            && request.resource.data.shiftId.matches('^' + request.resource.data.day + '-(' + request.resource.data.stationKey + '-)?[0-9]{4}$')
            && getAfter(counterPath(request.resource.data.shiftId)).data.lastSignup == signupId)
          ||
          (request.resource.data.status == 'venteliste' && request.resource.data.shiftId == null && request.resource.data.stationKey == '')
        )
      );
    }

    // Personindeks for overlappsjekk: bare skift-ID-er, ingen navn.
    // Kan slås opp på telefonnummer, men ikke listes. Skift kan bare legges til.
    match /people/{phone} {
      allow get: if true;
      allow list: if isAdmin();
      allow create: if isAdmin() || (
        phone.matches('^[+][1-9][0-9]{7,14}$')
        && request.resource.data.keys().hasOnly(['shifts'])
        && request.resource.data.shifts.keys().size() == 1
      );
      allow update: if isAdmin() || (
        request.resource.data.keys().hasOnly(['shifts'])
        && request.resource.data.shifts.keys().hasAll(resource.data.shifts.keys())
        && request.resource.data.shifts.keys().size() == resource.data.shifts.keys().size() + 1
      );
      allow delete: if isAdmin();
    }

    // Kaker: offentlig kan registrere (validert). Kakemottak-lenken leser og krysser av «levert».
    // Kaketypene må stemme med config (cakeTypes); legges en type til, må den også inn her.
    match /cakes/{cakeId} {
      function validCake(d) {
        return d.keys().hasOnly(['regId', 'name', 'phone', 'type', 'variant', 'glutenFree', 'lactoseFree', 'allergens', 'deliveryDay', 'delivered', 'source', 'createdAt'])
          && d.keys().hasAll(['regId', 'name', 'phone', 'type', 'variant', 'glutenFree', 'lactoseFree', 'allergens', 'deliveryDay', 'delivered', 'source', 'createdAt'])
          && d.regId is string && d.regId.size() <= 40
          && d.name is string && d.name.size() >= 2 && d.name.size() <= 80
          && d.phone is string && d.phone.matches('^[+][1-9][0-9]{7,14}$')
          && d.type in ['flotekake', 'formkake', 'muffins', 'vaffel']
          && d.variant is string && d.variant.size() <= 80
          && d.glutenFree is bool && d.lactoseFree is bool
          && d.allergens is string && d.allergens.size() <= 200
          && d.deliveryDay in ['d1', 'd2']
          && d.delivered == false
          && d.source == 'app'
          && d.createdAt == request.time;
      }
      function cakeLink() {
        return hasSession() && link().kind == 'kake';
      }

      allow read, update, delete: if isAdmin();
      allow create: if isAdmin() || validCake(request.resource.data);
      allow read: if cakeLink();
      allow update: if cakeLink()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['delivered'])
        && request.resource.data.delivered is bool
        && beforeDeadline();
    }

    // Gevinster: offentlig kan registrere (validert). Lesing, status og retting kun admin.
    match /prizes/{prizeId} {
      function validPrize(d) {
        return d.keys().hasOnly(['regId', 'sponsor', 'sponsorKey', 'contact', 'phone', 'gift', 'qty', 'value', 'book', 'status', 'source', 'createdAt'])
          && d.keys().hasAll(['regId', 'sponsor', 'sponsorKey', 'contact', 'phone', 'gift', 'qty', 'value', 'book', 'status', 'source', 'createdAt'])
          && d.regId is string && d.regId.size() <= 40
          && d.sponsor is string && d.sponsor.size() >= 2 && d.sponsor.size() <= 100
          && d.sponsorKey is string && d.sponsorKey.size() >= 3 && d.sponsorKey.size() <= 100 && !d.sponsorKey.matches('.*/.*')
          && d.contact is string && d.contact.size() >= 2 && d.contact.size() <= 80
          && d.phone is string && d.phone.matches('^[+][1-9][0-9]{7,14}$')
          && d.gift is string && d.gift.size() >= 2 && d.gift.size() <= 120
          && d.qty == 1
          && d.book == ''
          && d.value is int && d.value >= 0 && d.value <= 10000000
          && d.status == 'registrert'
          && d.source == 'app'
          && d.createdAt == request.time;
      }
      allow read, update, delete: if isAdmin();
      allow create: if isAdmin() || validPrize(request.resource.data);
    }

    // Sponsorsøk: bare ja/nei. Én treff om gangen, ingen detaljer.
    // Et innslag kan bare lages sammen med en ny gevinst for samme sponsor.
    match /sponsorIndex/{key} {
      allow get: if true;
      allow list: if request.query.limit <= 1;
      allow create, update: if isAdmin() || (
        request.resource.data.keys().hasOnly(['prize'])
        && request.resource.data.prize is string
        && !exists(/databases/$(database)/documents/prizes/$(request.resource.data.prize))
        && getAfter(/databases/$(database)/documents/prizes/$(request.resource.data.prize)).data.sponsorKey == key
      );
      allow delete: if isAdmin();
    }

    // Lenker: kun admin oppretter/sperrer. Den som kjenner koden, kan slå opp stasjonsnavnet.
    match /access/{token} {
      allow get: if true;
      allow list, write: if isAdmin();
    }

    // Kobler en anonym innlogging til en lenke. Bare gyldige lenker godtas.
    match /sessions/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['token'])
        && request.resource.data.token is string
        && exists(/databases/$(database)/documents/access/$(request.resource.data.token));
      allow delete: if isAdmin();
    }

    // Alt annet er stengt
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
